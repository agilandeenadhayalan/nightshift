{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "displayName": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ta",
              "en"
            ]
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "customer",
            "listener"
          ]
        },
        "listenerApproved": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "displayName",
        "languages",
        "mode",
        "listenerApproved",
        "online"
      ],
      "additionalProperties": false
    },
    "Rate": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "test-audio-v1",
            "test-video-v1"
          ],
          "type": "string"
        },
        "coinsPerMinute": {
          "type": "integer"
        },
        "microcreditsPerCoin": {
          "type": "integer"
        },
        "microcreditsPerSecond": {
          "type": "integer"
        },
        "freeThroughSeconds": {
          "type": "integer"
        },
        "minimumChargedSeconds": {
          "type": "integer"
        },
        "listenerPaisePerHour": {
          "type": "integer"
        },
        "testOnly": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "coinsPerMinute",
        "microcreditsPerCoin",
        "microcreditsPerSecond",
        "freeThroughSeconds",
        "minimumChargedSeconds",
        "listenerPaisePerHour",
        "testOnly"
      ],
      "additionalProperties": false
    },
    "Wallet": {
      "type": "object",
      "properties": {
        "balanceMicrocredits": {
          "type": "integer"
        },
        "heldMicrocredits": {
          "type": "integer"
        },
        "availableMicrocredits": {
          "type": "integer"
        },
        "testOnly": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "balanceMicrocredits",
        "heldMicrocredits",
        "availableMicrocredits",
        "testOnly"
      ],
      "additionalProperties": false
    },
    "Listener": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "displayName": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ta",
              "en"
            ]
          }
        },
        "online": {
          "type": "boolean"
        },
        "reachability": {
          "type": "string",
          "enum": [
            "foreground",
            "background_eligible",
            "offline"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean"
        },
        "favorite": {
          "type": "boolean"
        },
        "testOnly": {
          "type": "boolean"
        },
        "rate": {
          "$ref": "#/$defs/Rate"
        },
        "videoRate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "displayName",
        "languages",
        "online",
        "reachability",
        "available",
        "busy",
        "favorite",
        "testOnly",
        "rate"
      ],
      "additionalProperties": false
    },
    "Call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "customerId": {
          "type": "string",
          "format": "uuid"
        },
        "listenerId": {
          "type": "string",
          "format": "uuid"
        },
        "customerName": {
          "type": "string"
        },
        "listenerName": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "ringing",
            "connecting",
            "connected",
            "reconnecting",
            "ended"
          ]
        },
        "version": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "connectedMs": {
          "type": "integer"
        },
        "chargeMicrocredits": {
          "type": "integer"
        },
        "earningPaise": {
          "type": "integer"
        },
        "rate": {
          "$ref": "#/$defs/Rate"
        },
        "maxDurationSeconds": {
          "type": "integer"
        },
        "testOnly": {
          "const": true,
          "type": "boolean"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "audio",
            "video"
          ]
        }
      },
      "required": [
        "id",
        "customerId",
        "listenerId",
        "customerName",
        "listenerName",
        "state",
        "version",
        "createdAt",
        "expiresAt",
        "acceptedAt",
        "endedAt",
        "reason",
        "connectedMs",
        "chargeMicrocredits",
        "earningPaise",
        "rate",
        "maxDurationSeconds",
        "testOnly"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/User"
        },
        "activeCall": {
          "anyOf": [
            {
              "$ref": "#/$defs/Call"
            },
            {
              "type": "null"
            }
          ]
        },
        "listeners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Listener"
          }
        },
        "wallet": {
          "$ref": "#/$defs/Wallet"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "user",
        "activeCall",
        "listeners",
        "wallet",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "CallPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Call"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "CreateMatchingRequest": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "ta",
            "en"
          ]
        },
        "mediaType": {
          "type": "string",
          "const": "audio"
        },
        "quoteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "consent": {
          "type": "boolean",
          "const": true
        },
        "consentVersion": {
          "type": "string",
          "const": "matching-search-v1"
        }
      },
      "required": [
        "language",
        "mediaType",
        "quoteId",
        "consent",
        "consentVersion"
      ],
      "additionalProperties": false
    },
    "CancelMatchingRequest": {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "expectedVersion"
      ],
      "additionalProperties": false
    },
    "MatchingRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "searching",
            "ringing",
            "matched",
            "cancelled",
            "exhausted",
            "expired",
            "failed"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "ta",
            "en"
          ]
        },
        "mediaType": {
          "type": "string",
          "const": "audio"
        },
        "quoteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxAttempts": {
          "type": "integer",
          "const": 3
        },
        "waitBudgetSeconds": {
          "type": "integer",
          "const": 90
        },
        "invitationSeconds": {
          "type": "integer",
          "const": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "currentCallId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "terminalReason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "no_supply",
            "all_declined",
            "attempts_exhausted",
            "wait_budget_elapsed",
            "customer_cancelled",
            "source_session_ended",
            "account_restricted",
            "safety_blocked",
            "insufficient_balance",
            "quote_unavailable",
            null
          ]
        },
        "selectionReasons": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "language_match",
              "currently_available",
              "fair_rotation"
            ]
          }
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "testOnly": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "id",
        "version",
        "state",
        "language",
        "mediaType",
        "quoteId",
        "attemptCount",
        "maxAttempts",
        "waitBudgetSeconds",
        "invitationSeconds",
        "createdAt",
        "deadlineAt",
        "endedAt",
        "currentCallId",
        "terminalReason",
        "selectionReasons",
        "serverTime",
        "testOnly"
      ],
      "additionalProperties": false
    },
    "CurrentMatchingRequest": {
      "type": "object",
      "properties": {
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatchingRequest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "PreparePushRegistration": {
      "type": "object",
      "properties": {
        "targetKind": {
          "type": "string",
          "const": "fcm_token"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[!-~]+$"
        },
        "expectedVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "targetKind",
        "token",
        "expectedVersion"
      ],
      "additionalProperties": false
    },
    "ActivatePushRegistration": {
      "type": "object",
      "properties": {
        "registrationId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "bindingId": {
          "type": "string",
          "format": "uuid"
        },
        "notificationPermission": {
          "type": "string",
          "const": "granted"
        },
        "backgroundInvitations": {
          "type": "boolean",
          "const": true
        },
        "capabilityVersion": {
          "type": "string",
          "const": "android-audio-invitations-v1"
        },
        "consentVersion": {
          "type": "string",
          "const": "background-invitations-v1"
        }
      },
      "required": [
        "registrationId",
        "expectedVersion",
        "bindingId",
        "notificationPermission",
        "backgroundInvitations",
        "capabilityVersion",
        "consentVersion"
      ],
      "additionalProperties": false
    },
    "RevokePushRegistration": {
      "type": "object",
      "properties": {
        "registrationId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "registrationId",
        "expectedVersion"
      ],
      "additionalProperties": false
    },
    "PushRegistration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "bindingId": {
          "type": "string",
          "format": "uuid"
        },
        "targetKind": {
          "type": "string",
          "const": "fcm_token"
        },
        "state": {
          "type": "string",
          "enum": [
            "prepared",
            "active",
            "revoked",
            "expired"
          ]
        },
        "backgroundInvitations": {
          "type": "boolean"
        },
        "leaseExpiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "testOnly": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "id",
        "version",
        "bindingId",
        "targetKind",
        "state",
        "backgroundInvitations",
        "leaseExpiresAt",
        "serverTime",
        "testOnly"
      ],
      "additionalProperties": false
    },
    "CurrentPushRegistration": {
      "type": "object",
      "properties": {
        "registration": {
          "anyOf": [
            {
              "$ref": "#/$defs/PushRegistration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "registration"
      ],
      "additionalProperties": false
    },
    "CallInvitationPush": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "type": {
          "type": "string",
          "enum": [
            "call.invitation",
            "call.terminal"
          ]
        },
        "callId": {
          "type": "string",
          "format": "uuid"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "callVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "registrationId": {
          "type": "string",
          "format": "uuid"
        },
        "registrationVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        },
        "bindingId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "callId",
        "eventId",
        "callVersion",
        "expiresAt",
        "registrationId",
        "registrationVersion",
        "bindingId"
      ],
      "additionalProperties": false
    },
    "ListenerPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Listener"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "viewEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "viewEpoch",
        "expiresAt",
        "serverTime",
        "truncated"
      ],
      "additionalProperties": false
    },
    "ListenerStatusRequest": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "ta",
            "en"
          ]
        },
        "listenerIds": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "language",
        "listenerIds"
      ],
      "additionalProperties": false
    },
    "ListenerStatuses": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Listener"
          }
        },
        "removedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "items",
        "removedIds",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "DirectorySubscription": {
      "type": "object",
      "properties": {
        "viewEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "language": {
          "type": "string",
          "enum": [
            "ta",
            "en"
          ]
        },
        "visibleIds": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "viewEpoch",
        "language",
        "visibleIds"
      ],
      "additionalProperties": false
    },
    "DirectoryUpdate": {
      "type": "object",
      "properties": {
        "viewEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "language": {
          "type": "string",
          "enum": [
            "ta",
            "en"
          ]
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Listener"
          }
        },
        "removedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "viewEpoch",
        "language",
        "serverTime",
        "items",
        "removedIds"
      ],
      "additionalProperties": false
    },
    "DirectoryInvalidated": {
      "type": "object",
      "properties": {
        "viewEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "viewEpoch",
        "code"
      ],
      "additionalProperties": false
    },
    "Login": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "user": {
          "$ref": "#/$defs/User"
        },
        "testOnly": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "token",
        "expiresAt",
        "user",
        "testOnly"
      ],
      "additionalProperties": false
    },
    "OtpRequest": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+91[6-9][0-9]{9}$"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "consentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "phone",
        "deviceId",
        "consentVersion"
      ],
      "additionalProperties": false
    },
    "OtpVerifyRequest": {
      "type": "object",
      "properties": {
        "challengeId": {
          "type": "string",
          "format": "uuid"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+91[6-9][0-9]{9}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "challengeId",
        "phone",
        "code",
        "deviceId"
      ],
      "additionalProperties": false
    },
    "FirebaseVerifyRequest": {
      "type": "object",
      "properties": {
        "idToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "idToken"
      ],
      "additionalProperties": false
    },
    "OtpChallenge": {
      "type": "object",
      "properties": {
        "challengeId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "sending",
            "sent",
            "verifying",
            "consumed",
            "expired",
            "locked",
            "send_unknown",
            "verify_unknown",
            "superseded"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "retryAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "challengeId",
        "state",
        "expiresAt",
        "retryAt"
      ],
      "additionalProperties": false
    },
    "OtpProof": {
      "type": "object",
      "properties": {
        "customToken": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "needsOnboarding": {
          "type": "boolean"
        }
      },
      "required": [
        "customToken",
        "userId",
        "needsOnboarding"
      ],
      "additionalProperties": false
    },
    "PhoneIdentity": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "needsOnboarding": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "needsOnboarding"
      ],
      "additionalProperties": false
    },
    "PhoneSessionRequest": {
