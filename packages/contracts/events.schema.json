  "$ref": "#/$defs/Event",
  "x-socket-events": {
    "directory.subscribe": {
      "schema": "#/$defs/DirectorySubscription",
      "description": "Authenticated websocket auth.token; replaces the slice. null or empty visibleIds unsubscribes. ACK {ok:true,viewEpoch} or {ok:false,code}. Only served members of this owner/language epoch are accepted."
    },
    "directory.updated": {
      "schema": "#/$defs/DirectoryUpdate",
      "description": "Only the subscribed visible IDs. Live status changes immediately; preserve order until explicit refresh. Changed payloads checked each second; freshness at least every 15 seconds while healthy."
    },
    "directory.invalidated": {
      "schema": "#/$defs/DirectoryInvalidated",
      "description": "Expired, denied or unavailable subscription; mark stale and refresh explicitly."
    }
  }
