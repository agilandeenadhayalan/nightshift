{
  "name": "@nightshift/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env dist/src/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/src/seed.js",
    "test": "node --test dist/test/unit.test.js dist/test/firebase.test.js dist/test/msg91.test.js",
    "test:integration": "node --env-file-if-exists=../../.env --test --test-concurrency=1 --test-timeout=60000 dist/test/integration.test.js dist/test/schema.test.js dist/test/otp.test.js dist/test/phone-auth.test.js dist/test/firebase-phone.test.js dist/test/video.integration.test.js dist/test/account-onboarding.test.js dist/test/account-lifecycle.test.js dist/test/listener-applications.test.js dist/test/presence-races.test.js dist/test/discovery.test.js dist/test/call-authorization.test.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nightshift/backend-domain": "0.1.0",
    "agora-token": "2.0.7",
    "express": "5.2.1",
    "firebase-admin": "14.5.1",
    "pg": "8.23.1",
    "redis": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nightshift/contracts": "0.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3"
  }
}
