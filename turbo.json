{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".node-version"],
  "remoteCache": {"enabled": false},
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@nightshift/contracts#build": {"outputs": []},
    "@nightshift/backend-domain#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/audio/billing.mjs"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_ENV", "DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "DEV_AUTH_ENABLED", "DEV_ACCESS_KEY"]
    },
    "db:migrate": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:seed": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "DEV_AUTH_ENABLED", "DEV_ACCESS_KEY", "AGORA_APP_ID", "AGORA_APP_CERTIFICATE"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "DEV_AUTH_ENABLED", "DEV_ACCESS_KEY", "AGORA_APP_ID", "AGORA_APP_CERTIFICATE"]
    },
    "@nightshift/mobile#setup": {
      "cache": false,
      "passThroughEnv": ["FLUTTER_ROOT", "PUB_CACHE", "PUB_HOSTED_URL", "FLUTTER_STORAGE_BASE_URL", "LOCALAPPDATA", "APPDATA", "USERPROFILE", "SystemRoot"]
    },
    "@nightshift/mobile#typecheck": {
      "dependsOn": ["setup", "^build"],
      "cache": false,
      "passThroughEnv": ["FLUTTER_ROOT", "PUB_CACHE", "LOCALAPPDATA", "APPDATA", "USERPROFILE", "SystemRoot"]
    },
    "@nightshift/mobile#test": {
      "dependsOn": ["setup", "^build"],
      "cache": false,
      "passThroughEnv": ["FLUTTER_ROOT", "PUB_CACHE", "LOCALAPPDATA", "APPDATA", "USERPROFILE", "SystemRoot"]
    },
    "@nightshift/mobile#build:android": {
      "dependsOn": ["setup", "^build"],
      "cache": false,
      "passThroughEnv": ["FLUTTER_ROOT", "PUB_CACHE", "FLUTTER_STORAGE_BASE_URL", "JAVA_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT", "GRADLE_USER_HOME", "LOCALAPPDATA", "APPDATA", "USERPROFILE", "SystemRoot"]
    },
    "generate": {"cache": false},
    "generate:client": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["JAVA_HOME", "LOCALAPPDATA", "APPDATA", "USERPROFILE", "SystemRoot"]
    },
    "check:client": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["JAVA_HOME", "LOCALAPPDATA", "APPDATA", "USERPROFILE", "SystemRoot"]
    },
    "@nightshift/admin#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_TELEMETRY_DISABLED"]
    },
    "@nightshift/admin#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@nightshift/admin#test": {
      "cache": false
    },
    "@nightshift/admin#test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "SystemRoot", "LOCALAPPDATA", "TEMP", "TMP"]
    }
  }
}
