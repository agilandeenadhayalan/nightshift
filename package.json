{
  "name": "nightshift",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/mobile",
    "packages/backend-domain",
    "packages/contracts",
    "audio"
  ],
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "build": "turbo run build --filter=@nightshift/api...",
    "typecheck": "turbo run typecheck --filter=@nightshift/api...",
    "test": "turbo run test --filter=@nightshift/api... --filter=@nightshift/audio",
    "test:integration": "turbo run test:integration --filter=@nightshift/api",
    "test:audio": "turbo run test --filter=@nightshift/audio",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:review-reader": "node scripts/test-review-reader.mjs",
    "test:economics": "python -m unittest discover -s tests -p test_*.py",
    "db:migrate": "turbo run db:migrate --filter=@nightshift/api",
    "db:seed": "turbo run db:seed --filter=@nightshift/api",
    "start:api": "turbo run start --filter=@nightshift/api",
    "mobile:setup": "turbo run setup --filter=@nightshift/mobile",
    "check:mobile": "turbo run typecheck test --filter=@nightshift/mobile --concurrency=1",
    "build:android": "turbo run build:android --filter=@nightshift/mobile",
    "check:repo": "npm run check:secrets && npm run check:contracts && npm run check:boundaries && npm run test:tooling",
    "check:boundaries": "node scripts/check-boundaries.mjs && npm run check:boundaries --workspace @nightshift/backend-domain",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:contracts": "node packages/contracts/build-contract.mjs --check",
    "generate:client": "turbo run generate:client --filter=@nightshift/contracts",
    "check:client": "turbo run check:client --filter=@nightshift/contracts",
    "smoke:api": "node --env-file-if-exists=.env scripts/smoke-api.mjs",
    "smoke:accounts": "node --env-file-if-exists=.env scripts/smoke-account-client.cjs",
    "smoke:client": "node --env-file-if-exists=.env scripts/smoke-generated-client.mjs",
    "dev:admin": "npm run dev --workspace @nightshift/admin",
    "check:admin": "turbo run build typecheck test --filter=@nightshift/admin",
    "test:admin:e2e": "turbo run test:e2e --filter=@nightshift/admin"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
