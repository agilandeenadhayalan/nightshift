# Development only. Run scripts/setup-local.ps1 or setup-local.sh to generate local values.
NODE_ENV=development
PORT=3000
POSTGRES_USER=nightshift
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_DB=nightshift
DATABASE_URL=postgresql://nightshift:replace-with-generated-local-password@127.0.0.1:55432/nightshift
REDIS_URL=redis://127.0.0.1:56379
DEV_AUTH_ENABLED=true
DEV_ACCESS_KEY=replace-with-a-random-secret-at-least-24-characters
# Obtain these from your own Agora TEST project. Certificate stays on the API only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Private test video only; requires the same server-only Agora test configuration.
# Public rollout remains gated by the audio stability and video privacy review.
VIDEO_CALLS_ENABLED=false
# Optional server-side identity validation; disabled until owner test projects,
# Phone provider/region, private Admin permissions, consent and billing budget are ready.
# This does not enable production startup. New identities must complete adult onboarding.
PHONE_AUTH_ENABLED=false
# Selected native Firebase paid-SMS route; legacy msg91 remains optional.
PHONE_AUTH_PROVIDER=firebase
# Owner-selected development project; see docs/Firebase_Development_Setup.md.
FIREBASE_PROJECT_ID=nightshift-c3e1a
# Use Application Default Credentials; a local service-account file stays outside Git.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
PHONE_AUTH_DIGEST_KEY=
PHONE_AUTH_CONSENT_VERSION=
# Legacy MSG91 only: explicit owner-approved maximum provider send attempts/day (1..1000).
PHONE_AUTH_DAILY_SEND_LIMIT=
# App admission limit only. Firebase SDK SMS sends bypass the API; this is not a billing cap.
PHONE_AUTH_DAILY_ADMISSION_LIMIT=
MSG91_WIDGET_ID=
MSG91_AUTH_KEY=
# Absolute ignored private directory for local Listener-review WAV samples.
# Unset disables uploads. Never use a public/static directory.
PRIVATE_REVIEW_STORAGE_DIR=
# Separate staff authority. Activation needs native Firebase and explicit grants.
# Keep the stable digest key private; there is no default staff administrator.
STAFF_AUTH_ENABLED=false
STAFF_CONSOLE_ORIGIN=
STAFF_AUTH_DIGEST_KEY=
STAFF_AUTH_POLICY_VERSION=
STAFF_SESSION_SECONDS=1800
# Absolute private JSON file containing an explicitly owner-approved review policy.
# Unset keeps decisions and effects disabled. No example/test policy is bundled.
STAFF_REVIEW_POLICY_FILE=
# Staff web server only; these are fixed origins, never browser input.
STAFF_API_BASE_URL=
# Optional private DEBUG HTTPS directory, never a public web directory.
STAFF_LOCAL_TLS_DIR=
